project_name = "toptal"
environment  = "prod"

aws_region                = "us-east-1"
availability_zones        = ["us-east-1a", "us-east-1b"]
vpc_cidr                  = "10.0.0.0/16"
public_subnet_cidrs       = ["10.0.1.0/24", "10.0.2.0/24"]
private_app_subnet_cidrs  = ["10.0.11.0/24", "10.0.12.0/24"]
private_db_subnet_cidrs   = ["10.0.21.0/24", "10.0.22.0/24"]
alb_ingress_cidrs         = ["0.0.0.0/0"]
alb_ingress_ipv6_cidrs    = ["::/0"]

# The DB master password is generated by Terraform (see random_password.db in
# main.tf) -- it is never read from a variable, so there is nothing to set here.
db_username             = "toptaladmin"
db_name                 = "toptal"
existing_db_secret_name = "toptal-prod-db-credentials"

db_instance_class       = "db.t4g.micro"
allocated_storage       = 20
engine_version          = "15.18"
backup_retention_period = 7
deletion_protection     = true

# Set to a real ACM certificate ARN to enable HTTPS on the ALB and CloudFront.
certificate_arn    = ""
cloudfront_aliases = []

# Leave unset in CI -- the pipeline supplies the exact digest-pinned image URIs.
web_image = ""
api_image = ""
